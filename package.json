{
  "name": "playwright-qa-showcase",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test automation showcase against public demo apps (UI and API).",
  "author": "Rob Browning",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
